@model IReadOnlyList<Subapp1.Mvc.Entities.Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mt-4">
    <h2>Courses</h2>
    <a class="btn btn-primary" asp-action="Edit">New Course</a>
</div>

<table class="table table-striped mt-3">
    <thead>
    <tr><th>Code</th><th>Title</th><th>Description</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Code</td>
            <td>@c.Title</td>
            <td>@c.Description</td>
            <td>
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@c.Id" />
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
